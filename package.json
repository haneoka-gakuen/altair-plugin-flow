{
  "name": "@haneoka/altair-plugin-flow",
  "version": "0.1.0",
  "description": "Official canonical control-flow provider for Altair",
  "keywords": [
    "visual-novel",
    "control-flow",
    "story-editor",
    "altair"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/altair-plugin-flow.git"
  },
  "homepage": "https://github.com/haneoka-gakuen/altair-plugin-flow#readme",
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/altair-plugin-flow/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run verify:package",
    "prepack": "pnpm run check",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "peerDependencies": {
    "@haneoka/altair": "^0.1.0",
    "@haneoka/vega-protocol": "^0.1.0"
  },
  "devDependencies": {
    "@haneoka/altair": "^0.1.0",
    "@haneoka/vega-protocol": "^0.1.0",
    "typescript": "^6.0.3",
    "prettier": "3.7.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.14.0",
  "altair": {
    "pluginApi": 2,
    "kind": "flow",
    "capabilities": [
      "flow",
      "panel"
    ],
    "permissions": [],
    "targets": [
      "web",
      "pwa",
      "electron",
      "tauri",
      "android",
      "ios"
    ]
  },
  "dependencies": {
    "@haneoka/altair-ui-react": "^0.1.0",
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.11.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
